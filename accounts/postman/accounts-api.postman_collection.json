        "url": {
          "raw": "{{gatewayBaseUrl}}{{accountsBasePath}}/{{accountNumber}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "{{accountsBasePath}}",
            "{{accountNumber}}"
          ]
        },
        "description": "Deletes account by account number."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ],
