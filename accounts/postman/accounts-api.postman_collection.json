{
  "info": {
    "_postman_id": "0ec16185-e44d-430a-a3b6-e7bf07f20430",
    "name": "Accounts Service API",
    "description": "Postman collection for the accounts microservice routed via API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"mobileNumber\": \"0712345678\",\n  \"idNumber\": \"{{idNumber}}\",\n  \"branchAddress\": \"Cape Town Branch\"\n}"
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}{{accountsBasePath}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "{{accountsBasePath}}"
          ]
        },
        "description": "Creates an account for a South African ID number."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Find Accounts by ID Number",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayBaseUrl}}{{accountsBasePath}}/accounts?idNumber={{idNumber}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "{{accountsBasePath}}",
            "accounts"
          ],
          "query": [
            {
              "key": "idNumber",
              "value": "{{idNumber}}"
            }
          ]
        },
        "description": "Returns all accounts linked to an ID number."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let responseData = pm.response.json();",
              "if (Array.isArray(responseData) && responseData.length > 0 && responseData[0].accountNumber) {",
              "    pm.collectionVariables.set('accountNumber', responseData[0].accountNumber);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Find Account by Account Number",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayBaseUrl}}{{accountsBasePath}}/{{accountNumber}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "{{accountsBasePath}}",
            "{{accountNumber}}"
          ]
        },
        "description": "Returns a single account record."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
