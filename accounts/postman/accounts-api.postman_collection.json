              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Create Transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountNumber\": {{accountNumber}},\n  \"description\": \"Salary payment\",\n  \"amount\": 4500.00,\n  \"isImmediate\": true,\n  \"category\": \"SALARY\",\n  \"reference\": \"PAYROLL-2026-07\"\n}"
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}{{accountsBasePath}}/transaction",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "{{accountsBasePath}}",
            "transaction"
          ]
        },
        "description": "Creates a transaction for the selected account."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Get Transactions by ID and Date Range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayBaseUrl}}{{accountsBasePath}}/transaction/{{idNumber}}/{{startDate}}/{{endDate}}?pageNo=0&pageSize=10&sortBy=date&sortDir=desc",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "{{accountsBasePath}}",
            "transaction",
            "{{idNumber}}",
            "{{startDate}}",
            "{{endDate}}"
          ],
          "query": [
            {
              "key": "pageNo",
              "value": "0"
            },
            {
              "key": "pageSize",
              "value": "10"
            },
            {
              "key": "sortBy",
              "value": "date"
            },
            {
              "key": "sortDir",
              "value": "desc"
            }
          ]
        },
        "description": "Returns a paginated statement for all accounts linked to the ID number in the date range."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
