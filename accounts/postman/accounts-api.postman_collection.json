        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobileNumber\": \"0834567890\",\n  \"idNumber\": \"{{idNumber}}\",\n  \"branchAddress\": \"Durban Branch\"\n}"
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}{{accountsBasePath}}/{{accountNumber}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "{{accountsBasePath}}",
            "{{accountNumber}}"
          ]
        },
        "description": "Partially updates account details."
      },
      "event": [
        {
          "listen": "test",
