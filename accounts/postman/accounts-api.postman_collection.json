        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobileNumber\": \"0823456789\",\n  \"idNumber\": \"{{idNumber}}\",\n  \"branchAddress\": \"Johannesburg Branch\"\n}"
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}{{accountsBasePath}}/{{accountNumber}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "{{accountsBasePath}}",
            "{{accountNumber}}"
          ]
        },
        "description": "Replaces account details for the supplied account number."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
